rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'language', 'username', 'email', 'createdAt']) &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.language is string && data.language.size() <= 30 &&
             data.username is string && data.username.size() <= 30 &&
             data.email is string &&
             data.createdAt is string &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'desc', 'fullWork', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 50 &&
             data.desc is string && data.desc.size() <= 500 &&
             data.fullWork is string && data.fullWork.size() <= 20000 &&
             data.createdAt == request.time &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 100)) &&
             (!('music' in data) || (data.music is string && data.music.size() <= 100)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 50)) &&
             data.keys().size() <= 15;
    }

    function isValidMoment(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'title', 'year', 'location', 'type', 'mediaURL', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 50 &&
             data.title is string && data.title.size() <= 100 &&
             data.year is string && data.year.size() <= 4 &&
             data.location is string && data.location.size() <= 100 &&
             data.type in ['video', 'photo'] &&
             data.mediaURL is string && data.mediaURL.size() <= 2000 &&
             data.createdAt == request.time &&
             data.keys().size() <= 10;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 50 &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt == request.time &&
             (!('parentCommentId' in data) || (data.parentCommentId is string && isValidId(data.parentCommentId))) &&
             data.keys().size() <= 6;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['userId', 'type', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.type in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'anger'] &&
             data.createdAt == request.time &&
             data.keys().size() == 3;
    }

    // --- Match Blocks ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Prefer individual lookups or secure queries if needed
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL', 'language']);
    }

    match /posts/{postId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isEmailVerified() && isValidPost(incoming()) && isValidId(postId);
      allow update: if isEmailVerified() && isOwner(existing().authorId) && isValidPost(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['desc', 'fullWork', 'tags', 'music', 'color', 'likesCount', 'commentsCount']);
      allow delete: if isOwner(existing().authorId);

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isEmailVerified() && isValidComment(incoming()) && isValidId(commentId);
        allow delete: if isOwner(existing().authorId);
      }

      match /reactions/{userId} {
        allow get, list: if isSignedIn();
        allow create, update: if isEmailVerified() && isOwner(userId) && isValidReaction(incoming());
        allow delete: if isOwner(userId);
      }
    }

    match /moments/{momentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isEmailVerified() && isValidMoment(incoming()) && isValidId(momentId);
      allow update: if isEmailVerified() && isOwner(existing().authorId) && isValidMoment(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'year', 'location', 'mediaURL']);
      allow delete: if isOwner(existing().authorId);

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isEmailVerified() && isValidComment(incoming()) && isValidId(commentId);
        allow delete: if isOwner(existing().authorId);
      }

      match /reactions/{userId} {
        allow get, list: if isSignedIn();
        allow create, update: if isEmailVerified() && isOwner(userId) && isValidReaction(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
