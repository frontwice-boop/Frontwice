rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 0. Default Deny & Global Helpers
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin helper - bootstrapped with user email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'frontwice@gmail.com' && 
        request.auth.token.email_verified == true
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 1. Entity Validation Blueprints
    // ==========================================

    function isValidUser(data) {
      // Note: Map.keys() returns a List, which does NOT support .hasOnly() in rules.
      // Use size check + hasAll for strictness during create.
      return data.keys().hasAll(['displayName', 'language']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.language is string && data.language.size() <= 50 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp)) &&
             (!('followersCount' in data) || (data.followersCount is int)) &&
             (!('followingCount' in data) || (data.followingCount is int)) &&
             (!('worksCount' in data) || (data.worksCount is int));
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'desc', 'fullWork', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.desc is string && data.desc.size() <= 5000 &&
             data.fullWork is string && data.fullWork.size() <= 100000 &&
             data.createdAt == request.time &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 1000)) &&
             (!('genre' in data) || (data.genre is string && data.genre.size() <= 100)) &&
             (!('music' in data) || (data.music is string && data.music.size() <= 200)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 100)) &&
             (!('likesCount' in data) || (data.likesCount is int)) &&
             (!('commentsCount' in data) || (data.commentsCount is int)) &&
             (!('reactionCounts' in data) || (data.reactionCounts is map)) &&
             (!('characterCards' in data) || (data.characterCards is list)) &&
             (!('images' in data) || (data.images is list)) &&
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 5000000)) &&
             (!('mainObjective' in data) || (data.mainObjective is string)) &&
             (!('specificObjectives' in data) || (data.specificObjectives is list)) &&
             (!('researchAssets' in data) || (data.researchAssets is list));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'text', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000 &&
             (!('likesCount' in data) || (data.likesCount is int)) &&
             (!('commentsCount' in data) || (data.commentsCount is int));
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['userId', 'type', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.type in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'anger'] &&
             data.createdAt == request.time;
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followedId', 'createdAt']) &&
             data.followerId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // ==========================================
    // 2. Resource Match Blocks
    // ==========================================

    match /users/{userId} {
      // PII Protection: Only owner can see their private profile data
      // For this app, we consider the whole user doc public to simplify
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'language', 'username', 'bio', 'photoURL', 'email', 'worksCount']) ||
                    (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingCount']));

      match /following/{targetUserId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && isValidId(targetUserId) && isValidFollow(incoming());
        allow delete: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        // Secure list queries requirement: evaluate resource.data if filtering
        // This forces client to query where('authorId', '==', uid) if they want 100% success or just browse
        true 
      );
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if (isSignedIn() && (
        // Action: Owner edit
        (isOwner(existing().authorId) && isValidPost(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['desc', 'fullWork', 'tags', 'genre', 'music', 'color', 'coverImage'])) ||
        // Action: Counter increment/decrement (from client, with security risk but allowed for simple demo)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      )) || isAdmin();
      allow delete: if isOwner(existing().authorId) || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming()) && incoming().createdAt == request.time;
        allow update: if (isSignedIn() && (
                      (isOwner(existing().authorId) && isValidComment(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'likesCount', 'commentsCount'])) ||
                      (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
                    )) || isAdmin();
        allow delete: if isOwner(existing().authorId) || isAdmin();
        
        match /likes/{userId} {
          allow read: if isSignedIn();
          allow create, delete: if isOwner(userId);
        }
      }

      match /{path=**}/likes/{userId} {
        allow read: if isOwner(userId);
      }

      match /reactions/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId) && isValidReaction(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Legacy support or alternative path
    match /moments/{momentId} {
       allow read, write: if isAdmin(); // Redirected to posts collection in code
    }
  }
}
